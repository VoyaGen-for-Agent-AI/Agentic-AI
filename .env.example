# ── LLM（OpenRouter 相容 OpenAI SDK）────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
# LLM 節流秒數：改用付費 provider 後預設 0（不節流）。
# 若切回免費模型 (:free) 做 demo，設 5 可避免 OpenRouter 回 429。
LLM_THROTTLE_SECONDS=0

# ── Demo 顯示開關 ──────────────────────────────────────────────
DEMO_SHOW_DEBUG=0
# 設 1 時，最終回覆會附上「資料來源摘要」，標示每段結果是 API / LLM / mock。
DEMO_SHOW_SOURCES=0

# ── 各 stage 的「即時資料」開關 ────────────────────────────────
# 一律預設 0（走內建 mock），確保沒有金鑰也能完整跑完 demo。
# 設為 1 時才會嘗試真實來源，失敗會自動退回 mock，流程不中斷。
USE_LIVE_WEATHER=0
WEATHER_PROVIDER=llm
USE_LIVE_SPOT=0
SPOT_PROVIDER=mock
USE_LIVE_TRAFFIC=0
TRAFFIC_PROVIDER=llm
USE_LIVE_ITINERARY=0
USE_LIVE_BOOKING=0

# ── 外部資料 API ───────────────────────────────────────────────
# OpenWeather：搭配 USE_LIVE_WEATHER=1 且 WEATHER_PROVIDER=openweather。
OPENWEATHER_API_KEY=
# Tavily：spot / traffic / booking / budget agent 的搜尋佐證來源。
TAVILY_API_KEY=

# ── E2B 沙盒 ───────────────────────────────────────────────────
# 未設定時 e2b_validation stage 會標記為 skipped，不會讓流程失敗。
E2B_API_KEY=

# ── Langfuse 追蹤 ──────────────────────────────────────────────
# public / secret 任一為空時自動停用追蹤，不影響主流程。
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
